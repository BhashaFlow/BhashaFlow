# Copy to .env when a track starts reading configuration.
# Scaffolding does not load this file. Leave secrets blank.

# Logging for a future desktop process: debug, info, warning, error.
BHASHAFLOW_LOG_LEVEL=info

# Vision capture. fixture replays the demo script (CI). desktop grabs the
# primary monitor and needs screen-recording permission.
BHASHAFLOW_CAPTURE=fixture

# Stage overlay. 1 shows the side panel, 0 hides it. CI only checks draw
# instructions and does not open a window.
BHASHAFLOW_OVERLAY=1

# Speech-to-text and speech synthesis. Audio track (Alucard).
BHASHAFLOW_STT_API_KEY=
BHASHAFLOW_TTS_API_KEY=

# Optional http(s) attention model. Empty keeps the fixture heuristic, which
# is what CI runs. The request sends element names, not pixels.
BHASHAFLOW_VISION_ENDPOINT=
