# Copy to .env for `uv run bhashaflow` or `uv run bhashaflow-demo --live`.
# Those commands load this file and do not override variables already exported.
# `uv run bhashaflow-demo` does not load it. Leave secrets blank in git.

# Logging: debug, info, warning, error. Live mode also writes JSON to stderr.
BHASHAFLOW_LOG_LEVEL=info
BHASHAFLOW_LOG_FORMAT=json

# Live speech-to-text. auto tries the Muse realtime socket, then Muse file
# transcription of muse-voice-transcribe-1.0. file skips the socket.
# realtime fails the process if the socket does not open. fixture is refused
# by the live command.
BHASHAFLOW_STT=auto

# Muse HTTP timeout in seconds, and extra attempts after the first try.
BHASHAFLOW_MUSE_TIMEOUT_S=8
BHASHAFLOW_MUSE_RETRIES=2

# Vision capture. The rehearsal ignores this file. desktop grabs the primary
# monitor and needs screen-recording permission. An explicit fixture value
# makes `bhashaflow` exit 2 instead of grounding a fake scene.
BHASHAFLOW_CAPTURE=desktop

# Stage overlay. 1 shows the side panel, 0 hides it. CI only checks draw
# instructions and does not open a window.
BHASHAFLOW_OVERLAY=1

# Muse Voice Transcribe (muse-voice-transcribe-1.0). Empty keeps the fixture
# catalog, which is what CI runs. MODEL_API_KEY is the Model API dashboard name.
# BHASHAFLOW_MUSE_API_KEY and BHASHAFLOW_STT_API_KEY are accepted aliases.
MODEL_API_KEY=
BHASHAFLOW_MUSE_API_KEY=
BHASHAFLOW_STT_API_KEY=

# Confirmations. Muse has no TTS model. status records a line and does not
# play audio or focus a window. beep is a local tone. command is an optional
# non-Muse executable; set BHASHAFLOW_TTS_COMMAND to that program.
BHASHAFLOW_TTS_BACKEND=status
BHASHAFLOW_TTS_COMMAND=
BHASHAFLOW_TTS_API_KEY=

# Optional one-word indicator (idle, listening, thinking, acting, confirming).
# The voice plane overwrites this file. It does not open a window.
BHASHAFLOW_STATUS_FILE=

# Action engine. desktop shells out to OS commands and still refuses apps
# outside Files, Preview, Sheets, and Mail. fixture makes `bhashaflow` exit 2.
BHASHAFLOW_ACTIONS=desktop

# Optional http(s) attention model. Empty keeps the fixture heuristic, which
# is what CI runs. The request sends element names, not pixels.
BHASHAFLOW_VISION_ENDPOINT=

# Tight-loop planner for the live command. muse uses muse-spark-1.3.
# reasoning_effort is low. fixture makes `bhashaflow` exit 2.
BHASHAFLOW_PLANNER=muse

# Optional SAM 3.1 region boxes. 1 plus a Model API key calls the model.
# The fixture demo leaves this unset and keeps accessibility boxes.
BHASHAFLOW_SAM=
